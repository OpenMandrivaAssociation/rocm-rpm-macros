# ROCm packaging macros for OpenMandriva
# Keep version/tag/GPU lists here so the whole stack can bump together.

# --- Version lock (TheRock 10.1 / system LLVM 23) --------------------------
# Upstream amdclang in 10.1 is LLVM 24. Cooker clang is still 23.1.3, so
# packages keep building against system LLVM 23.
%rocm_major			10
%rocm_minor			1
%rocm_patch			0
%rocm_release			%{rocm_major}.%{rocm_minor}
%rocm_version			%{rocm_release}.%{rocm_patch}

# Tag / source URL style: therock-10.0 vs rocm-7.2.x
# Switch %rocm_tag_prefix to "rocm-" only if retreating to the stable stream.
%rocm_tag_prefix		therock-
%rocm_src_tag			%{rocm_tag_prefix}%{rocm_release}

# Monorepo release assets (source tarballs, not binaries)
%rocm_systems_release_url	https://github.com/ROCm/rocm-systems/releases/download/%{rocm_src_tag}
%rocm_libraries_release_url	https://github.com/ROCm/rocm-libraries/releases/download/%{rocm_src_tag}

# Component source helpers:
#   Source0: %{rocm_systems_source clr}
#   Source0: %{rocm_llvm_project_source}
%rocm_systems_source()		%{rocm_systems_release_url}/%{1}.tar.gz#/%{1}-%{rocm_version}.tar.gz
%rocm_libraries_source()	%{rocm_libraries_release_url}/%{1}.tar.gz#/%{1}-%{rocm_version}.tar.gz
%rocm_llvm_project_source	https://github.com/ROCm/llvm-project/archive/refs/tags/%{rocm_src_tag}.tar.gz#/llvm-project-%{rocm_src_tag}.tar.gz
%rocm_component_source()	https://github.com/ROCm/%{1}/archive/refs/tags/%{rocm_src_tag}.tar.gz#/%{1}-%{rocm_src_tag}.tar.gz

# --- Install layout (FHS, no /opt/rocm) ------------------------------------
%rocm_prefix			%{_prefix}
%rocm_libdir			%{_libdir}
%rocm_includedir		%{_includedir}
%rocm_datadir			%{_datadir}/rocm
%rocm_bitcode_dir		%{_libdir}/amdgcn/bitcode
%rocm_cmake_dir			%{_libdir}/cmake

# --- GPU ISA lists ---------------------------------------------------------
# Default set for Cooker: Polaris (gfx803, OM-restored runtime) + common
# Radeon/Instinct. Every gfx* multiplies build time (especially rocBLAS).
# gfx803 needs ROCr doorbell + r800 image patches (rocm-runtime >= 7.14.0-9).
#
# These stay static so every rpm -q does not spawn clang. Packages that
# should pick up new families (gfx1500 / RDNA6, …) on the next rebuild
# invoke the detector instead of hardcoding:
#   %global hip_archs %{rocm_detect_gpu_archs}
#   %global rocm_gpu_targets gfx803;%{rocm_detect_gpu_targets}
# %rocm_gpu_archs_skip (space-separated) drops an ISA without a rebuild
# of this package. The detector never looks at the builder's GPU
# (amdgpu-arch / rocminfo).
%rocm_gpu_targets		gfx803;gfx906;gfx908;gfx90a;gfx942;gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201
%rocm_gpu_archs_fallback	gfx906 gfx908 gfx90a gfx942 gfx1030 gfx1100 gfx1101 gfx1102 gfx1200 gfx1201

# clang -mcpu=help ∩ %{rocm_bitcode_dir}/oclc_isa_version_*.bc.
# Keep discrete / CDNA product chips; drop *-generic, GCN gfx6/7/8
# (Polaris stays on the static list), RDNA1, RDNA2 SKU variants,
# RDNA3/4 APUs. Family 13+ is kept as soon as both LLVM and
# device-libs ship the ISA.
%rocm_detect_gpu_archs() %{lua:\
local fallback = {}\
for a in rpm.expand("%{rocm_gpu_archs_fallback}"):gmatch("%S+") do fallback[#fallback+1] = a end\
local function exists(p)\
	local f = io.open(p, "r")\
	if f then f:close() return true end\
	return false\
end\
local function isa_num(name)\
	return tonumber(name:sub(4), 16) or 0\
end\
local function keep(name)\
	if not name:match("^gfx[0-9a-f][0-9a-f][0-9a-f]+$") then return false end\
	local rest = name:sub(4)\
	local fam, minor\
	if rest:match("^1[0-9]") and #rest >= 4 then\
		fam = tonumber(rest:sub(1,2))\
		minor = rest:sub(3)\
	else\
		fam = tonumber(rest:sub(1,1))\
		minor = rest:sub(2)\
	end\
	if not fam or fam <= 8 then return false end\
	if fam == 9 then\
		if minor == "06" or minor == "08" or minor == "0a" or minor == "40" or minor == "41" or minor == "42" then return true end\
		local first = minor:sub(1,1)\
		return first == "5" or first == "6" or first == "7" or first == "8" or first == "9" or first == "a" or first == "b" or first == "c" or first == "d" or first == "e" or first == "f"\
	end\
	if fam == 10 then return name == "gfx1030" end\
	if fam == 11 then return name == "gfx1100" or name == "gfx1101" or name == "gfx1102" end\
	if fam == 12 then return name == "gfx1200" or name == "gfx1201" end\
	return true\
end\
local skip = {}\
for s in rpm.expand("%{?rocm_gpu_archs_skip}"):gmatch("%S+") do skip[s] = true end\
local clang = rpm.expand("%{_bindir}") .. "/clang"\
if not exists(clang) then clang = "clang" end\
local h = io.popen(clang .. " -target amdgcn-amd-amdhsa -mcpu=help 2>&1")\
local out = h and (h:read("*a") or "") or ""\
if h then h:close() end\
local cpus = {}\
for name in out:gmatch("gfx[0-9a-f][0-9a-f][0-9a-f]+") do\
	cpus[name] = true\
end\
local bcdir = rpm.expand("%{rocm_bitcode_dir}")\
local list = {}\
for name, _ in pairs(cpus) do\
	if keep(name) and not skip[name] and exists(bcdir .. "/oclc_isa_version_" .. name:sub(4) .. ".bc") then\
		list[#list+1] = name\
	end\
end\
if #list == 0 then list = fallback end\
table.sort(list, function(a,b) return isa_num(a) < isa_num(b) end)\
print(table.concat(list, " "))\
}

# Semicolon form for -DAMDGPU_TARGETS / -DGPU_TARGETS.
%rocm_detect_gpu_targets() %{lua:\
local s = rpm.expand("%{rocm_detect_gpu_archs}")\
print((s:gsub(" ", ";")))\
}

# Header-only / lightweight primitives: full matrix including gfx803
%rocm_gpu_targets_prim		%{rocm_gpu_targets}

# Subsets for packages that cannot afford the full matrix or lack gfx803 kernels
# hipBLASLt: upstream cmake SUPPORTED_ARCHITECTURES has no gfx803; TensileLite
# ships no r9nano logic (only navi3x/4x + CDNA). Cannot enable without new
# solution YAML + validation patches — use rocBLAS on Polaris instead.
%rocm_gpu_targets_hipblaslt	gfx1100;gfx1101;gfx1200;gfx1201
# RCCL: add gfx803 for Polaris multi-GPU / device kernels (upstream default omits it)
%rocm_gpu_targets_rccl		gfx803;gfx906;gfx908;gfx90a;gfx942;gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201
# Dense BLAS (Tensile). gfx803 = r9nano asm_full (Polaris/Fiji).
# GFX11/12 need python-tensile with the true16 f16 convert patch for LLVM 23.
%rocm_gpu_targets_blas		gfx803;gfx906;gfx908;gfx90a;gfx942;gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201
%rocm_gpu_targets_test		gfx803;gfx1100;gfx1101;gfx1201

# CMake argument forms (quote targets: ';' is shell metacharacter)
%rocm_cmake_gpu_targets		-DAMDGPU_TARGETS="%{rocm_gpu_targets}" -DGPU_TARGETS="%{rocm_gpu_targets}"
%rocm_cmake_gpu_targets_prim	-DAMDGPU_TARGETS="%{rocm_gpu_targets_prim}" -DGPU_TARGETS="%{rocm_gpu_targets_prim}"
%rocm_cmake_gpu_targets_blas	-DAMDGPU_TARGETS="%{rocm_gpu_targets_blas}" -DGPU_TARGETS="%{rocm_gpu_targets_blas}"

# --- Common CMake options for ROCm components ------------------------------
%rocm_cmake_fhs		-DCMAKE_INSTALL_PREFIX=%{rocm_prefix} -DCMAKE_INSTALL_LIBDIR=%{_lib} -DFILE_REORG_BACKWARD_COMPATIBILITY=OFF -DINCLUDE_PATH_COMPATIBILITY=OFF -DROCM_SYMLINK_LIBS=OFF
# Prefer Ninja when the package uses imperative %cmake
%rocm_cmake_generator		-G Ninja

# --- Toolchain hints (used once hipcc exists) ------------------------------
%__cc_rocm			hipcc
%__cxx_rocm			hipcc
# Raw clang + enable_language(HIP): needs FHS bitcode path (hip-lang also sets this)
%rocm_hip_clang_flags	--rocm-path=%{rocm_prefix} --rocm-device-lib-path=%{rocm_bitcode_dir}

# --- Dense BLAS / Tensile packaging notes ----------------------------------
# Full %rocm_gpu_targets_blas (gfx803 through gfx12) TensileCreateLibrary is RAM-heavy.
# Cap at 8 jobs in rocblas.spec (-DTensile_CPU_THREADS=8); 32 OOMs on 64G hosts.
# Prefer TMPDIR on a large disk (/home), not small /tmp tmpfs.
# true16 f16 converts need python-tensile with 0002-true16-f16-cvt-llvm23.patch.

# Minimum system LLVM major expected for this ROCm stream
%rocm_llvm_maj_ver		23
